---
import type { I18n } from '@/i18n/en'
import '@/styles/global.css'

interface Props {
  t: I18n
  canonicalUrl: string
}

const { t, canonicalUrl } = Astro.props
const { title, description, siteName } = t.meta
const ogImage = new URL('/og.png', Astro.site).href
const ogLocaleAlternate = t.lang === 'ja' ? 'en_US' : 'ja_JP'
const alternateUrls = [
  { hreflang: 'ja', href: new URL('/', canonicalUrl).href },
  { hreflang: 'en', href: new URL('/en/', canonicalUrl).href },
  { hreflang: 'x-default', href: new URL('/', canonicalUrl).href },
]
const gaId = import.meta.env.PUBLIC_GA_ID
/** Bump when `public/favicon.svg` changes — browsers cache favicons aggressively. */
const faviconVersion = 2
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" href={`/favicon.svg?v=${faviconVersion}`} type="image/svg+xml" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />
    {alternateUrls.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}

    <!-- OGP -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={t.locale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@rushhirosan" />
    <meta name="twitter:creator" content="@rushhirosan" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Google Analytics (production only, offloaded via Partytown) -->
    {import.meta.env.PROD && gaId && (
      <>
        <script
          type="text/partytown"
          src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
        />
        <script type="text/partytown" define:vars={{ gaId }}>
          window.dataLayer = window.dataLayer || []
          function gtag() { dataLayer.push(arguments) }
          gtag('js', new Date())
          gtag('config', gaId)
        </script>
      </>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{t.a11y.skipToMain}</a>
    <slot />
  </body>
</html>
