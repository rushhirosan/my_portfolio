---
import { Image } from 'astro:assets'
import type { I18n } from '@/i18n/en'
import profileImage from '@/assets/profile.jpg'

interface Props {
  t: I18n
}

const { t } = Astro.props
---

<section id="about">
  <div class="container">
    <h2 class="section-title">{t.sections.about}</h2>
    <div class="about-inner">
      <div class="about-avatar">
        <Image
          src={profileImage}
          alt={t.about.avatarAlt}
          width={120}
          height={120}
          densities={[1, 2]}
          loading="lazy"
          decoding="async"
          class="about-avatar-img"
        />
      </div>
      <div class="about-content">
        <p class="bio">{t.about.bio}</p>
        <h3 class="about-subheading">{t.about.profileTitle}</h3>
        <ul class="profile-list" aria-label={t.about.profileTitle}>
          {t.about.profile.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <h3 class="about-subheading">{t.about.interestsTitle}</h3>
        <ul class="interests-list" aria-label={t.about.interestsTitle}>
          {t.about.interests.map((interest) => (
            <li><span class="interest-tag">{interest}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about-inner {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .about-avatar {
    flex-shrink: 0;
    width: 120px;
    height: 120px;
    line-height: 0;
  }

  .about-avatar-img {
    display: block;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    background: #fff;
  }

  .bio {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--space-sm);
  }

  .profile-list {
    list-style: disc;
    padding-left: 1.2rem;
    color: var(--color-text-muted);
    display: grid;
    gap: 0.35rem;
    margin-bottom: var(--space-md);
  }

  .about-subheading {
    font-size: var(--text-sm);
    font-weight: 700;
    margin-bottom: var(--space-xs);
  }

  .interests-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .interest-tag {
    display: inline-block;
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
  }

  @media (max-width: 640px) {
    .about-inner {
      flex-direction: column;
    }
  }
</style>
