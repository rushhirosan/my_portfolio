---
import type { I18n } from '@/i18n/en'

interface Props {
  t: I18n
}

const { t } = Astro.props
---

<section id="about">
  <div class="container">
    <h2 class="section-title">{t.sections.about}</h2>
    <div class="about-inner">
      <div
        class="about-avatar"
        role="img"
        aria-label={t.about.avatarAlt}
      >
        <span class="about-avatar-text" aria-hidden="true">RH</span>
      </div>
      <div class="about-content">
        <p class="bio">{t.about.bio}</p>
        <h3 class="about-subheading">{t.about.profileTitle}</h3>
        <ul class="profile-list" aria-label={t.about.profileTitle}>
          {t.about.profile.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
        <h3 class="about-subheading">{t.about.interestsTitle}</h3>
        <ul class="interests-list" aria-label={t.about.interestsTitle}>
          {t.about.interests.map((interest) => (
            <li><span class="interest-tag">{interest}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .about-inner {
    display: flex;
    align-items: flex-start;
    gap: var(--space-md);
  }

  .about-avatar {
    flex-shrink: 0;
    width: 120px;
    height: 120px;
    border-radius: 28%;
    display: grid;
    place-items: center;
    background: linear-gradient(145deg, #6366f1 0%, #a855f7 52%, #f472b6 100%);
    border: 3px solid #fff;
    box-shadow:
      0 2px 0 rgba(0, 0, 0, 0.06),
      0 12px 28px rgba(99, 102, 241, 0.35);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  @media (prefers-reduced-motion: no-preference) {
    .about-avatar:hover {
      transform: scale(1.04) rotate(-2deg);
      box-shadow:
        0 2px 0 rgba(0, 0, 0, 0.06),
        0 16px 36px rgba(168, 85, 247, 0.4);
    }
  }

  .about-avatar-text {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.06em;
    line-height: 1;
    color: #fff;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.2);
    user-select: none;
  }

  .bio {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: var(--space-sm);
  }

  .profile-list {
    list-style: disc;
    padding-left: 1.2rem;
    color: var(--color-text-muted);
    display: grid;
    gap: 0.35rem;
    margin-bottom: var(--space-md);
  }

  .about-subheading {
    font-size: var(--text-sm);
    font-weight: 700;
    margin-bottom: var(--space-xs);
  }

  .interests-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .interest-tag {
    display: inline-block;
    font-size: 0.75rem;
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
  }

  @media (max-width: 640px) {
    .about-inner {
      flex-direction: column;
    }
  }
</style>
