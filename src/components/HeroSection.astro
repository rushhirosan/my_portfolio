---
import type { I18n } from '@/i18n/en'
import { articles } from '@/data/writing'
import { links } from '@/data/links'

interface Props {
  t: I18n
}

const { t } = Astro.props

const primaryLinks = links.filter((l) => ['github', 'x'].includes(l.icon ?? ''))
const writingSorted = [...articles].sort((a, b) => b.publishedAt.localeCompare(a.publishedAt))
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container">
    <h1 id="hero-heading" class="name">Rush(y) Hirosan</h1>
    <p class="tagline">{t.hero.tagline}</p>

    {primaryLinks.length > 0 && (
      <ul class="hero-links" aria-label={t.hero.socialLabel}>
        {primaryLinks.map((link) => (
          <li>
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${link.label} (${t.a11y.externalLink})`}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    )}

    {writingSorted.length > 0 && (
      <div id="writing" class="hero-writing" aria-labelledby="writing-heading">
        <h2 id="writing-heading" class="hero-writing-title">{t.sections.writing}</h2>
        <ul class="hero-links">
          {writingSorted.map((article) => {
            const title = article.title[t.lang as 'en' | 'ja']
            return (
              <li>
                <a
                  href={article.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${title} (${t.a11y.externalLink})`}
                >
                  {title}
                </a>
              </li>
            )
          })}
        </ul>
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    padding: var(--space-xl) 0;
    border-bottom: none !important;
  }

  .name {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: var(--space-xs);
  }

  .tagline {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    margin-bottom: var(--space-sm);
  }

  .hero-writing {
    margin-top: var(--space-md);
    scroll-margin-top: 5rem;
  }

  .hero-writing-title {
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-xs);
  }

  .hero-links {
    display: flex;
    gap: var(--space-sm);
    list-style: none;
    flex-wrap: wrap;
  }

  .hero-links a {
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    text-decoration: none;
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 1px;
    transition: color 0.15s, border-color 0.15s;
  }

  .hero-links a:hover {
    color: var(--color-text);
    border-color: var(--color-text);
    text-decoration: none;
  }
</style>
