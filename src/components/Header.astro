---
import type { I18n } from '@/i18n/en'

interface Props {
  t: I18n
  lang: string
}

const { t, lang } = Astro.props
const altLang = lang === 'ja' ? 'en' : 'ja'
const altHref = lang === 'ja' ? '/en/' : '/'
const altLabel = lang === 'ja' ? 'EN' : 'JA'
---

<header class="header">
  <div class="container header-inner">
    <a href={lang === 'ja' ? '/' : '/en/'} class="site-name">Rush(y) Hirosan</a>

    <nav aria-label="Main navigation">
      <ul class="nav-list">
        <li><a href="#products">{t.nav.products}</a></li>
        <li><a href="#writing">{t.nav.writing}</a></li>
        <li><a href="#about">{t.nav.about}</a></li>
      </ul>
    </nav>

    <a
      href={altHref}
      class="lang-switch"
      aria-label={t.a11y.switchToJa}
      lang={altLang}
    >
      {altLabel}
    </a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    z-index: 100;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    height: 3.5rem;
  }

  .site-name {
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-name:hover {
    text-decoration: none;
  }

  .nav-list {
    display: flex;
    gap: var(--space-sm);
    list-style: none;
    flex: 1;
  }

  .nav-list a {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    text-decoration: none;
    transition: color 0.15s;
  }

  .nav-list a:hover {
    color: var(--color-text);
    text-decoration: none;
  }

  .lang-switch {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    padding: 0.2em 0.6em;
    border-radius: var(--radius);
    transition: border-color 0.15s, color 0.15s;
  }

  .lang-switch:hover {
    color: var(--color-text);
    border-color: #aaa;
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .nav-list {
      display: none;
    }
  }
</style>
