---
import type { I18n } from '@/i18n/en'
import { articles } from '@/data/writing'
import WritingItem from './WritingItem.astro'

interface Props {
  t: I18n
}

const { t } = Astro.props
const sorted = [...articles].sort((a, b) => b.publishedAt.localeCompare(a.publishedAt))
---

<section id="writing">
  <div class="container">
    <h2 class="section-title">{t.sections.writing}</h2>
    <ul class="writing-list">
      {sorted.map((article) => (
        <WritingItem article={article} t={t} />
      ))}
    </ul>
  </div>
</section>

<style>
  .writing-list {
    list-style: none;
  }
</style>
